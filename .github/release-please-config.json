{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "skip-changelog": true,
      "separate-pull-requests": false,
      "group-pull-request-title-pattern": "chore: release ${version}",
      "extra-files": [
        {
          "type": "toml",
          "path": "/**/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value.match(/^zixy/))].version",
          "glob": true
        },
        {
          "type": "toml",
          "path": "/zixy/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/zixy-py/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/zixy-py/Cargo.toml",
          "jsonpath": "$.dependencies.zixy.version"
        },
        {
          "type": "toml",
          "path": "/zixy-py/docs/uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'zixy')].version",
          "glob": true
        },
        {
          "type": "toml",
          "path": "/zixy-py/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "/zixy-py/zixy/__init__.py"
        }
      ]
    }
  }
}
